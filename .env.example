APP_NAME="Services Co-operative Bank Template"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
CLIENT=kalliaseri-scb

# Database connection (MySQL 8 / MariaDB 10.6+ for production)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=services_coop_bank
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
ALLOW_SQLITE_FALLBACK=true

# Mail settings
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@coopbank.local
MAIL_FROM_NAME="Co-operative Bank"

# Security & Uploads
SESSION_LIFETIME=120
UPLOAD_MAX_FILESIZE_MB=5
